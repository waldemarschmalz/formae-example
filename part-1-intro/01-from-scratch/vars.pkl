workload = "formae-demo"
environment = "dev"

stackName = "stack-\(workload)-\(environment)"

/// Target Azure subscription ID. No default — set this before running `formae eval`/`apply`
/// so you can't accidentally deploy to the wrong tenant.
subscriptionId: String(!isEmpty) = read("env:AZURE_SUBSCRIPTION_ID")

/// Approved Azure regions for this demo. Any other value will fail eval.
typealias AllowedLocation = "westeurope" | "northeurope" | "francecentral"

/// Approved SQL Database SKU names for this demo.
typealias AllowedDbSku = "Basic" | "S0" | "S1"
